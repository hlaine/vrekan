(
    max_health: 55.0,
    move_speed: 80.0,
    aggro_range: 170.0,
    melee_range: 45.0,
    melee_damage: 10.0,
    melee_cooldown: 1.1,
    melee_damage_type: "primal",
    crit_chance: 0.05,
    crit_multiplier: 1.5,
    // Slightly hardier convert than the farmer — a modest resistance to
    // mundane physical strikes, not yet the "christian" holy/radiant types
    // introduced by later tiers (see DESIGN.md's Enemy tiering).
    resistances: {"primal": 0.1},
    color: (0.85, 0.8, 0.6),
    size: 30.0,
    xp_reward: 15.0,
    // Bleed: each landed hit ramps up the per-tick damage rather than just
    // refreshing the clock — demonstrates AddMagnitude stacking (see
    // MECHANICS.md's Combat section).
    effects: [
        (
            id: "bleed",
            kind: DamageOverTime(damage_type: "primal", tick_interval: 1.0),
            duration: 4.0,
            magnitude: 3.0,
            stack_mode: AddMagnitude,
            applies_to: Target,
        ),
    ],
    drop_chance: 0.5,
    loot_table: [
        (kind: Item("rusty_sword"), weight: 1.0),
        (kind: Item("leather_armor"), weight: 1.0),
        (kind: Rune("crit_shard"), weight: 2.0),
        (kind: Currency(20), weight: 3.0),
    ],
)
