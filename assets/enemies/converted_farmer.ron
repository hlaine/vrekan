(
    max_health: 40.0,
    move_speed: 90.0,
    aggro_range: 150.0,
    melee_range: 40.0,
    melee_damage: 8.0,
    melee_cooldown: 1.0,
    melee_damage_type: "primal",
    crit_chance: 0.05,
    crit_multiplier: 1.5,
    color: (0.8, 0.15, 0.15),
    size: 28.0,
    xp_reward: 10.0,
    // Daze: repeated hits just extend the stun, not stack its length —
    // demonstrates RefreshDuration stacking (see MECHANICS.md's Combat
    // section). Only a chance per hit, and duration is kept well under
    // melee_cooldown (1.0s) on purpose: a guaranteed stun whose duration
    // outlasts the farmer's own attack cooldown can permalock the target
    // (every hit refreshes the clock before it expires) — found via live
    // testing, not a hypothetical.
    effects: [
        (
            id: "daze",
            kind: Stun,
            duration: 0.6,
            magnitude: 0.0,
            stack_mode: RefreshDuration,
            applies_to: Target,
            chance: 0.25,
        ),
    ],
    drop_chance: 0.35,
    loot_table: [
        (kind: Item("wolf_pelt_cap"), weight: 1.0),
        (kind: Rune("swift_shard"), weight: 2.0),
    ],
)
