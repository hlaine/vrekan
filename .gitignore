# Generated by Cargo
/target/

# Cargo.lock is intentionally tracked: server and client are binaries,
# and reproducible builds matter more than the flexibility Cargo.lock
# ignoring gives to library crates.

# Backup files generated by rustc
*.rs.bk

# MSVC debug symbols
*.pdb

# Editor/OS cruft
.DS_Store
.idea/
.vscode/
*.swp

# Runtime-generated save data and client identity — see server/src/persistence.rs
# and client/src/main.rs's load_or_create_character_id.
/saves/
character_id.txt
